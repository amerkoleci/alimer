<Project>
  <Choose>
    <When Condition="($([MSBuild]::IsOsPlatform('windows')) and '$(RuntimeIdentifier)'=='') or '$(RuntimeIdentifier)'=='win-x64'">
      <ItemGroup>
        <None Include="$(AlimerNativeDirectory)win-x64/SDL3.dll" Link="SDL3.dll" Visible="False" CopyToOutputDirectory="PreserveNewest" />
        <None Include="$(AlimerNativeDirectory)win-x64/alimer_native.dll" Link="alimer_native.dll" Visible="False" CopyToOutputDirectory="PreserveNewest" />
        <!-- Optional for now -->
        <None Include="$(AlimerNativeDirectory)win-x64/alimer_gpu.dll" Link="alimer_gpu.dll" Visible="False" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(AlimerNativeDirectory)win-x64/alimer_gpu.dll')" />
        <None Include="$(AlimerNativeDirectory)win-x64/alimer_gpu_d.pdb" Link="alimer_gpu_d.pdb" Visible="False" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(AlimerNativeDirectory)win-x64/alimer_gpu_d.pdb')" />
        <None Include="$(AlimerNativeDirectory)win-x64/alimer_gpu_d.dll" Link="alimer_gpu_d.dll" Visible="False" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(AlimerNativeDirectory)win-x64/alimer_gpu_d.dll')" />
      </ItemGroup>
    </When>
    <When Condition="($([MSBuild]::IsOsPlatform('windows')) and '$(RuntimeIdentifier)'=='') or '$(RuntimeIdentifier)'=='win-arm64'">
      <ItemGroup>
        <None Include="$(AlimerNativeDirectory)win-arm64/alimer_native.dll" Link="alimer_native.dll" Visible="False" CopyToOutputDirectory="PreserveNewest" />
      </ItemGroup>
    </When>
    <When Condition="($([MSBuild]::IsOsPlatform('linux')) and '$(RuntimeIdentifier)'=='') or '$(RuntimeIdentifier)'=='linux-x64'">
      <ItemGroup>
        <None Include="$(AlimerNativeDirectory)linux-x64/libalimer_native.so" Link="libalimer_native.so" Visible="False" CopyToOutputDirectory="PreserveNewest" />
      </ItemGroup>
    </When>
    <When Condition="($([MSBuild]::IsOsPlatform('osx')) and '$(RuntimeIdentifier)'=='') or '$(RuntimeIdentifier)'=='osx-universal'">
      <ItemGroup>
        <None Include="$(AlimerNativeDirectory)osx/libalimer_native.dylib" Link="libalimer_native.dylib" Visible="False" CopyToOutputDirectory="PreserveNewest" />
      </ItemGroup>
    </When>
  </Choose>

</Project>
